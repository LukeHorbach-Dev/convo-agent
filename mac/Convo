#!/bin/bash
# Convo.app's program. It only chooses which copy of Convo to run, then hands over to that copy's mac/start.sh:
#   - the copy inside this app, or
#   - a newer copy that Convo downloaded from GitHub (in ~/Library/Application Support/Convo/versions).
# Putting a new Convo.app in Applications by hand always wins over downloaded updates.
# This file is kept tiny on purpose: everything else can be updated from GitHub.
set -u
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
BUNDLED="$CONTENTS/Resources/app"
SUPPORT="$HOME/Library/Application Support/Convo"
mkdir -p "$SUPPORT"
BV="$(cat "$BUNDLED/VERSION")"
if [ "$(cat "$SUPPORT/bundled" 2>/dev/null)" != "$BV" ]; then
  echo "$BV" > "$SUPPORT/bundled"
  rm -f "$SUPPORT/current"
fi
CODE="$BUNDLED"
CUR="$(cat "$SUPPORT/current" 2>/dev/null || true)"
if [ -n "$CUR" ] && [ -f "$SUPPORT/versions/$CUR/mac/start.sh" ]; then
  CODE="$SUPPORT/versions/$CUR"
fi
export CONVO_BUNDLE="$(dirname "$CONTENTS")"
exec /bin/bash "$CODE/mac/start.sh" "$CODE" "$@"

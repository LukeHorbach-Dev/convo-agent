#!/bin/bash
# Convo.app's program: opens Convo, setting it up first if this version hasn't been set up yet.
# Your data lives in ~/Library/Application Support/Convo, so replacing the app with a newer one keeps everything.
set -u
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
APP="$CONTENTS/Resources/app"
SUPPORT="$HOME/Library/Application Support/Convo"
LOGS="$HOME/Library/Logs/Convo"
VERSION="$(cat "$APP/VERSION")"
mkdir -p "$SUPPORT" "$LOGS"

if [ "$(cat "$SUPPORT/.installed" 2>/dev/null)" != "$VERSION" ] || [ ! -x "$SUPPORT/venv/bin/python" ]; then
  # First time (or a new version): set up in a Terminal window, so you can see it working and any problem.
  SETUP="$APP/mac/setup.sh"
  osascript - "$SETUP" "$APP" <<'OSA'
on run argv
  set cmd to "bash " & quoted form of (item 1 of argv) & " " & quoted form of (item 2 of argv)
  tell application "Terminal"
    activate
    do script cmd
  end tell
end run
OSA
  exit 0
fi

cd "$SUPPORT"
export PYTHONPATH="$APP" CONVO_LOGS="$LOGS" PYTHONDONTWRITEBYTECODE=1
exec "$SUPPORT/venv/bin/python" -m assistant app >> "$LOGS/launcher.log" 2>&1

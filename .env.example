# Copy to .env and adjust. Never commit .env (it is git-ignored).
AGENT_PLATFORM=mock                 # mock | mock_web | instagram
AGENT_MODE=simulate                 # observe | draft | simulate (mock only) | execute
AGENT_ACCOUNT_USERNAME=lukehorbach2
AGENT_PROFILE_PATH=data/profile.json
AGENT_DB_PATH=data/agent.db
AGENT_POLL_INTERVAL_S=30

AGENT_LLM__PROVIDER=fake            # fake | anthropic
AGENT_LLM__MODEL=claude-opus-5-5
# AGENT_LLM__API_KEY=sk-ant-...     # or rely on ANTHROPIC_API_KEY

AGENT_BROWSER__HEADLESS=false
AGENT_BROWSER__USER_DATA_DIR=data/browser-profile

AGENT_LIMITS__DAILY_SEND_LIMIT=25
AGENT_LIMITS__MAX_WAITING_INTROS=10
AGENT_LIMITS__DAILY_UNFOLLOW_LIMIT=50
AGENT_LIMITS__MAX_ATTEMPTS=4
AGENT_CIRCUIT__FAILURE_THRESHOLD=5
AGENT_POLICY__AUDIENCE=following     # following: say hello to people you follow | followers: to new followers
AGENT_POLICY__INTRO_EXISTING_FOLLOWERS=false
AGENT_POLICY__RETENTION_DAYS=180
AGENT_DASHBOARD__PORT=8765
